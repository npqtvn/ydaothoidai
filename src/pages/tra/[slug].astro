---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import OrderForm from '../../components/OrderForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../lib/data';
import { settings, home, pad } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const images = [d.image, ...d.gallery].filter(Boolean);
const others = (await getProducts()).filter((x) => x.id !== p.id).slice(0, 3);
const steps = home.sections.find((s: any) => s.type === 'steps' && s.enabled !== false) as any;
---
<Base title={d.title} description={d.short} image={d.image}>
  <section class="p-hero" style={d.color ? `--tone:${d.color}` : ''}>
    <div class="container p-grid">
      <div class="p-gallery">
        <a class="p-main" href={images[0]} target="_blank"><img src={images[0]} alt={d.title} id="pmain" /></a>
        {images.length > 1 && (
          <div class="p-thumbs">
            {images.map((src, i) => <button class={i === 0 ? 'on' : ''} data-src={src} aria-label={`Ảnh ${i + 1}`}><img src={src} alt="" loading="lazy" /></button>)}
          </div>
        )}
      </div>
      <div class="p-info">
        <nav class="crumb"><a href="/">Trang chủ</a> / <a href="/#san-pham">Sản phẩm</a></nav>
        {d.badge && <span class="badge">{d.badge}</span>}
        <h1>{d.title}</h1>
        {d.tagline && <p class="tagline script">{d.tagline}</p>}
        <p class="short">{d.short}</p>
        <div class="price">
          <strong>{d.price || 'Liên hệ'}</strong>
          {d.price_note && <span>{d.price_note}</span>}
        </div>
        <div class="p-btns">
          <a class="btn btn-accent" href="#dat-tra">Đặt trà ngay <Icon name="arrow" /></a>
          <a class="btn btn-zalo" href={settings.zalo} target="_blank" rel="noopener">Tư vấn Zalo {settings.hotline_display}</a>
        </div>
        {d.suitable.length > 0 && (
          <div class="suit">
            <h2>Phù hợp với</h2>
            <ul class="check-list">{d.suitable.map((x) => <li>{x}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {d.effects.length > 0 && (
    <section class="section bg-alt">
      <div class="container">
        <div class="sec-head"><span class="sec-label">Tác dụng chính</span><h2>Công dụng của {d.title}</h2></div>
        <div class="eff">
          {d.effects.map((e, i) => (
            <article class="eff-item reveal"><span>{pad(i + 1)}</span><h3>{e.title}</h3><p>{e.text}</p></article>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.ingredients.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="sec-head"><span class="sec-label">Thành phần</span><h2>Các vị thuốc trong bài</h2></div>
        <div class="ing">
          {d.ingredients.map((g) => (
            <div class="ing-item reveal"><Icon name="leaf" /><div><strong>{g.name}</strong><span>{g.text}</span></div></div>
          ))}
        </div>
        <div class="prose body"><Content /></div>
      </div>
    </section>
  )}

  {steps && (
    <section class="section bg-alt">
      <div class="container">
        <div class="sec-head"><span class="sec-label">Cách dùng</span><h2>{steps.title}</h2></div>
        <ol class="mini-steps">
          {steps.items.map((s: any, i: number) => <li><span>{i + 1}</span><strong>{s.title}</strong><p>{s.text}</p></li>)}
        </ol>
      </div>
    </section>
  )}

  <section class="section bg-dark" id="dat-tra">
    <div class="container order-wrap">
      <div>
        <span class="sec-label">Đặt trà</span>
        <h2>Đặt {d.title}</h2>
        <p>Điền thông tin, chúng tôi sẽ gọi lại xác nhận đơn. Hoặc nhắn Zalo <a href={settings.zalo} style="color:#f5d79a">{settings.hotline_display}</a> để được tư vấn ngay.</p>
      </div>
      <OrderForm selected={d.title} />
    </div>
  </section>

  {others.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="sec-head"><span class="sec-label">Xem thêm</span><h2>Các dòng trà khác</h2></div>
        <div class="others">{others.map((o) => <ProductCard p={o} />)}</div>
      </div>
    </section>
  )}

  <script>
    const main = document.querySelector<HTMLImageElement>('#pmain');
    document.querySelectorAll<HTMLButtonElement>('.p-thumbs button').forEach((b) =>
      b.addEventListener('click', () => {
        if (!main) return;
        main.src = b.dataset.src!;
        (main.parentElement as HTMLAnchorElement).href = b.dataset.src!;
        document.querySelectorAll('.p-thumbs button').forEach((x) => x.classList.toggle('on', x === b));
      })
    );
  </script>
</Base>

<style>
  .p-hero { --tone: var(--primary); padding: 40px 0 70px; }
  .p-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 60px); align-items: start; }
  .p-gallery { position: sticky; top: 92px; }
  .p-main { display: block; border-radius: calc(var(--radius) * 1.3); overflow: hidden; background: var(--bg-alt); aspect-ratio: 4/5; box-shadow: 0 24px 50px rgba(47, 74, 43, .18); }
  .p-main img { width: 100%; height: 100%; object-fit: contain; }
  .p-thumbs { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .p-thumbs button { width: 74px; height: 74px; padding: 0; border-radius: 12px; overflow: hidden; border: 2px solid transparent; cursor: pointer; background: var(--bg-alt); }
  .p-thumbs button.on { border-color: var(--accent); }
  .p-thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .crumb { font-size: .85rem; margin-bottom: 14px; }
  .crumb a { color: inherit; opacity: .7; text-decoration: none; }
  .badge { display: inline-block; background: var(--accent); color: #fff; font-size: .75rem; font-weight: 700; padding: 4px 12px; border-radius: 999px; text-transform: uppercase; margin-bottom: 10px; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); color: var(--tone); }
  .tagline { font-size: 1.45rem; color: var(--accent); line-height: 1.3; }
  .short { font-size: 1.08rem; }
  .price { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; padding: 16px 20px; border-radius: var(--radius); background: var(--bg-alt); margin: 18px 0; }
  .price strong { font-family: var(--font-heading); font-size: 1.8rem; color: var(--accent); }
  .price span { font-size: .9rem; opacity: .8; }
  .p-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-zalo { background: #0068ff; color: #fff; }
  .suit { margin-top: 28px; padding: 22px 24px; border-radius: var(--radius); border: 1px dashed color-mix(in srgb, var(--primary) 30%, transparent); }
  .suit h2 { font-size: 1.3rem; }
  .eff { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; }
  .eff-item { padding: 26px; background: #fffdf7; border-radius: var(--radius); box-shadow: 0 10px 30px rgba(47, 74, 43, .07); }
  .eff-item span { font-family: var(--font-heading); font-size: 2.4rem; font-weight: 700; color: transparent; -webkit-text-stroke: 1.5px var(--accent); line-height: 1; }
  .eff-item h3 { font-size: 1.25rem; margin: .5em 0 .3em; }
  .ing { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .ing-item { display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; background: #fffdf7; border-radius: var(--radius); border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent); }
  .ing-item :global(svg) { width: 34px; height: 34px; flex: none; padding: 7px; border-radius: 50%; background: var(--primary); color: #fff; }
  .ing-item strong { display: block; color: var(--primary); text-transform: uppercase; letter-spacing: .03em; font-size: .95rem; }
  .ing-item span { font-size: .9rem; }
  .body { max-width: 820px; margin: 40px auto 0; text-align: center; }
  .mini-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; counter-reset: s; }
  .mini-steps li { background: #fffdf7; padding: 22px; border-radius: var(--radius); }
  .mini-steps span { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--primary); color: #fff; font-weight: 700; margin-bottom: 8px; }
  .mini-steps strong { display: block; color: var(--primary); font-size: 1.1rem; }
  .mini-steps p { margin: 4px 0 0; font-size: .92rem; }
  .order-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 40px; align-items: center; }
  .order-wrap h2 { font-size: clamp(1.8rem, 3.4vw, 2.4rem); }
  .others { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 900px) {
    .p-grid, .order-wrap { grid-template-columns: 1fr; }
    .p-gallery { position: static; }
    .others { grid-template-columns: 1fr; }
  }
</style>
