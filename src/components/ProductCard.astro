---
import Icon from './Icon.astro';
const { p } = Astro.props;
const d = p.data;
---
<article class="pcard reveal" style={d.color ? `--tone:${d.color}` : ''}>
  <a class="pimg" href={`/tra/${p.id}/`}>
    <img src={d.image} alt={d.title} loading="lazy" />
    {d.badge && <span class="pbadge">{d.badge}</span>}
  </a>
  <div class="pbody">
    <h3><a href={`/tra/${p.id}/`}>{d.title}</a></h3>
    <p>{d.short}</p>
    <div class="pfoot">
      <span class="pprice">{d.price || d.price_note || 'Liên hệ'}</span>
      <a class="plink" href={`/tra/${p.id}/`}>Xem chi tiết <Icon name="arrow" /></a>
    </div>
  </div>
</article>

<style>
  .pcard {
    --tone: var(--primary);
    background: #fffdf7; border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent); box-shadow: 0 10px 30px rgba(47, 74, 43, .07);
    transition: transform .25s, box-shadow .25s;
  }
  .pcard:hover { transform: translateY(-6px); box-shadow: 0 22px 44px rgba(47, 74, 43, .15); }
  .pimg { position: relative; display: block; aspect-ratio: 4/4.4; overflow: hidden; background: var(--bg-alt); }
  .pimg img { width: 100%; height: 100%; object-fit: cover; object-position: center 70%; transition: transform .5s; }
  .pcard:hover .pimg img { transform: scale(1.05); }
  .pbadge {
    position: absolute; top: 14px; left: 14px; background: var(--accent); color: #fff; font-size: .75rem;
    font-weight: 700; padding: 5px 12px; border-radius: 999px; letter-spacing: .05em; text-transform: uppercase;
  }
  .pbody { padding: 22px 22px 20px; display: flex; flex-direction: column; flex: 1; border-top: 4px solid var(--tone); }
  h3 { font-size: 1.3rem; margin-bottom: .35em; }
  h3 a { color: var(--tone); text-decoration: none; }
  p { font-size: .95rem; flex: 1; }
  .pfoot { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding-top: 12px; border-top: 1px dashed color-mix(in srgb, var(--primary) 18%, transparent); }
  .pprice { font-weight: 700; color: var(--accent); font-size: .92rem; }
  .plink { display: inline-flex; align-items: center; gap: 4px; font-weight: 600; font-size: .9rem; text-decoration: none; color: var(--primary); }
  .plink :global(svg) { width: 16px; height: 16px; }
</style>
