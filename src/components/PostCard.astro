---
import { fmtDate } from '../lib/data';
const { p } = Astro.props;
const d = p.data;
---
<article class="post reveal">
  <a href={`/bai-viet/${p.id}/`} class="post-img">{d.cover && <img src={d.cover} alt="" loading="lazy" />}</a>
  <div class="post-body">
    <time>{fmtDate(d.date)}</time>
    <h3><a href={`/bai-viet/${p.id}/`}>{d.title}</a></h3>
    {d.excerpt && <p>{d.excerpt}</p>}
  </div>
</article>

<style>
  .post { background: #fffdf7; border-radius: var(--radius); overflow: hidden; box-shadow: 0 10px 30px rgba(47, 74, 43, .07); }
  .post-img { display: block; aspect-ratio: 16/10; background: var(--bg-alt); overflow: hidden; }
  .post-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .post:hover .post-img img { transform: scale(1.05); }
  .post-body { padding: 18px 20px 20px; }
  time { font-size: .8rem; color: var(--accent); font-weight: 600; }
  h3 { font-size: 1.15rem; margin: .3em 0 .4em; }
  h3 a { color: var(--primary); text-decoration: none; }
  p { font-size: .92rem; margin: 0; }
</style>
