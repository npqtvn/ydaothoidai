---
import SectionHead from '../SectionHead.astro';
import { md } from '../../lib/site';
const { s } = Astro.props;
---
<SectionHead label={s.label} title={s.title} intro={s.intro} />
<div class="faq">
  {(s.items ?? []).map((f: any, i: number) => (
    <details class="reveal" open={i === 0}>
      <summary>{f.q}</summary>
      <div class="ans" set:html={md(f.a)} />
    </details>
  ))}
</div>

<style>
  .faq { max-width: 820px; margin: 0 auto; display: grid; gap: 12px; }
  details { background: #fffdf7; border-radius: var(--radius); border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent); }
  summary {
    cursor: pointer; list-style: none; padding: 18px 56px 18px 22px; font-weight: 600; color: var(--primary); position: relative;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 20px; top: 50%; transform: translateY(-50%); width: 28px; height: 28px;
    border-radius: 50%; display: grid; place-items: center; background: var(--primary); color: #fff; font-size: 1.2rem; transition: transform .2s;
  }
  details[open] summary::after { content: '–'; }
  .ans { padding: 0 22px 16px; }
</style>
