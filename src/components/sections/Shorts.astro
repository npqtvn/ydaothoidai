---
// Khối "YouTube Shorts": tự lấy các Short mới nhất của kênh mỗi lần web build lại.
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import VCard from '../VCard.astro';
import { getShorts } from '../../lib/youtube';
const { s } = Astro.props;
const channelId = (s.channel_id || '').trim();
const count = Math.max(1, Number(s.count) || 8);
const shorts = (await getShorts(channelId)).slice(0, count);
const moreUrl = s.button_link || `https://www.youtube.com/channel/${channelId}/shorts`;
---
{shorts.length > 0 && (
  <>
    <SectionHead label={s.label} title={s.title} intro={s.intro} />
    <div class="vcards swipe">
      {shorts.map((v) => <VCard yt={v.id} img={v.thumb} caption={v.title} />)}
    </div>
    {s.button_label && (
      <p class="smore">
        <a class="btn btn-outline" href={moreUrl} target="_blank" rel="noopener">{s.button_label} <Icon name="arrow" /></a>
      </p>
    )}
  </>
)}

<style>
  .smore { text-align: center; margin: 32px 0 0; }
</style>
