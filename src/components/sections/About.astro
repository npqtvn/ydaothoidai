---
import { md } from '../../lib/site';
const { s } = Astro.props;
---
<div class="about">
  {s.image && (
    <div class="a-img reveal">
      <img src={s.image} alt={s.title} loading="lazy" />
    </div>
  )}
  <div class="a-text reveal">
    {s.label && <span class="sec-label">{s.label}</span>}
    <h2>{s.title}</h2>
    <div class="prose" set:html={md(s.text)} />
    {s.stats?.length > 0 && (
      <div class="stats">
        {s.stats.map((st: any) => (
          <div class="stat">
            <strong>{st.number}<small>{st.unit}</small></strong>
            <span>{st.text}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .about { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .a-img { position: relative; max-width: 420px; justify-self: center; }
  .a-img::before {
    content: ''; position: absolute; inset: 18px -18px -18px 18px; border: 2px solid var(--accent);
    border-radius: calc(var(--radius) * 1.4);
  }
  .a-img img { position: relative; border-radius: calc(var(--radius) * 1.4); width: 100%; }
  h2 { font-size: clamp(1.8rem, 3.4vw, 2.5rem); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 26px; }
  .stat { padding: 18px 14px; border-radius: var(--radius); background: var(--bg-alt); text-align: center; }
  .stat strong { display: block; font-family: var(--font-heading); font-size: 2.1rem; color: var(--primary); line-height: 1.1; }
  .stat small { font-size: .9rem; margin-left: 4px; color: var(--accent); font-family: var(--font-body); }
  .stat span { font-size: .85rem; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .stats { grid-template-columns: 1fr 1fr 1fr; gap: 8px; } .stat strong { font-size: 1.6rem; } }
</style>
