---
import SectionHead from '../SectionHead.astro';
import { pad } from '../../lib/site';
const { s } = Astro.props;
const items = s.items ?? [];
const withImage = !!s.image;
---
<SectionHead label={s.label} title={s.title} intro={s.intro} />
<div class={`feat ${withImage ? 'feat-split' : 'feat-cols'} style-${s.style || 'numbered'}`}>
  {withImage && <div class="feat-img reveal"><img src={s.image} alt={s.title} loading="lazy" /></div>}
  <div class="feat-list">
    {items.map((it: any, i: number) => (
      <article class="feat-item reveal">
        <span class="feat-num">{pad(i + 1)}</span>
        <div>
          <h3>{it.title}</h3>
          {it.text && <p>{it.text}</p>}
          {it.points?.length > 0 && <ul class="check-list">{it.points.map((p: string) => <li>{p}</li>)}</ul>}
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .feat-split { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .feat-img { position: sticky; top: 100px; }
  .feat-img img { border-radius: calc(var(--radius) * 1.4); box-shadow: 0 24px 50px rgba(47, 74, 43, .18); width: 100%; }
  .feat-split .feat-list { display: grid; gap: 22px; }
  .feat-cols .feat-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .feat-item {
    display: grid; grid-template-columns: auto 1fr; gap: 18px; padding: 26px;
    background: #fffdf7; border-radius: var(--radius); border: 1px solid color-mix(in srgb, var(--primary) 10%, transparent);
    box-shadow: 0 10px 30px rgba(47, 74, 43, .06);
  }
  .feat-cols .feat-item { grid-template-columns: 1fr; }
  .feat-num {
    font-family: var(--font-heading); font-size: 2.6rem; font-weight: 700; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent);
  }
  .style-cards .feat-num {
    -webkit-text-stroke: 0; color: #fff; background: var(--primary); font-size: 1.1rem;
    width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center;
  }
  h3 { font-size: 1.3rem; margin-bottom: .4em; }
  p { margin-bottom: .8em; }
  @media (max-width: 860px) {
    .feat-split { grid-template-columns: 1fr; }
    .feat-img { position: static; max-width: 520px; margin: 0 auto; }
    .feat-item { padding: 20px; gap: 14px; }
  }
</style>
